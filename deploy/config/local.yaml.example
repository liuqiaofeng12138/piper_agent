# 复制为 local.yaml 后填写 llm.api_key（含密钥的 local.yaml 勿提交 Git）

listen: ":50051"
log_level: info
max_concurrent_runs: 4
mock: false
relax_deps: true
skip_storage_wait: false

engine:
  Name: piper_go-api
  Host: 0.0.0.0
  Port: 8888
  WebAPI:
    noAuth: true
    notification: false
    requireDeps: true
    requiredContainers:
      - elasticsearch
      - minio
      - prometheus
    depsMaxWaitSeconds: 120
    skipStorageWait: false
    storageWaitEveryMs: 5000
  ES:
    host: 127.0.0.1
    port: 9200
    username: elastic
    password: mG0pL3aL
  S3:
    endpointUrl: http://127.0.0.1:9000
    accessKey: admin
    secretKey: jQ2@xF0@
  H2:
    path: ../../engine/etc/db/raw_meta.db
  Requester:
    connectTimeout: 80000
    readTimeout: 120000
    tokenTimeout: 120000
    requestPerSecondLimit: 20
  Chrome:
    enabled: true
    headless: false
    agentCount: 1

runtime:
  address: "127.0.0.1:50051"

gateway:
  listen: ":8080"
  chat_timeout_seconds: 600
  max_request_body_bytes: 1048576
  rate_limit_per_minute: 60
  auth:
    mode: none
    token: ""
  session:
    driver: sqlite
    sqlite_path: "../../data/gateway.db"
  classifier:
    mode: rule          # rule | llm（llm 模式复用下方 llm 段，失败自动回退 rule）
    # model: ""         # 默认复用 llm.model，可指定更小的分类模型
    timeout_ms: 4000

# 子 Agent 注册表（列表格式；也兼容旧的 map 格式 agents.web_crawler.listen）
# module 为该 Agent 的 Python Worker 模块（默认 piper_agent.workers.<id>）；
# piper-serve 启动时 PYTHONPATH 会同时覆盖 claw_agent/src 与 agents/src。
agents:
  - id: web_crawler
    display_name: "网页采集"
    description: "自然语言描述网页抓取/数据采集任务，生成 Piper 模版并调用 Runtime 执行"
    listen: "127.0.0.1:15061"
    enabled: true
    module: claw_agent.workers.web_crawler      # claw_agent 项目（采集专用）
  - id: general_chat
    display_name: "通用对话"
    description: "日常问答、知识咨询、闲聊等非采集类对话"
    listen: "127.0.0.1:15062"
    enabled: true
    default: true       # 意图未命中时的兜底 Agent
    module: piper_agent.workers.general_chat    # agents 项目（平台通用）

llm:
  provider: openai
  model: gpt-4o
  api_key: ""
  # base_url: "https://api.deepseek.com"

harness:
  max_steps: 20
  require_validate_before_run: true
  max_runs_per_session: 10
  audit_log: "../../logs/agent_audit.jsonl"
