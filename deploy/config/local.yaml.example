# 复制为 local.yaml 后填写 llm.api_key（含密钥的 local.yaml 勿提交 Git）

listen: ":50051"
log_level: info
max_concurrent_runs: 4
mock: false
relax_deps: true
skip_storage_wait: false

engine:
  Name: piper_go-api
  Host: 0.0.0.0
  Port: 8888
  WebAPI:
    noAuth: true
    notification: false
    requireDeps: true
    requiredContainers:
      - elasticsearch
      - minio
      - prometheus
    depsMaxWaitSeconds: 120
    skipStorageWait: false
    storageWaitEveryMs: 5000
  ES:
    host: 127.0.0.1
    port: 9200
    username: elastic
    password: mG0pL3aL
  S3:
    endpointUrl: http://127.0.0.1:9000
    accessKey: admin
    secretKey: jQ2@xF0@
  H2:
    path: ../../engine/etc/db/raw_meta.db
  Requester:
    connectTimeout: 80000
    readTimeout: 120000
    tokenTimeout: 120000
    requestPerSecondLimit: 20
  Chrome:
    enabled: true
    headless: false
    agentCount: 1
    # 持久化登录态（相对 deploy/config）；微博等需登录站点建议配置
    userDataDir: "../../data/chrome_piper"
    # 非 headless 时每次 Chrome 任务结束后多保留窗口的秒数（0=立即关闭）
    manualLoginWaitSeconds: 0

runtime:
  address: "127.0.0.1:50051"

gateway:
  listen: ":8080"
  chat_timeout_seconds: 600
  max_request_body_bytes: 1048576
  max_upload_body_bytes: 33554432
  rate_limit_per_minute: 60
  auth:
    mode: login         # none | bearer | login
    jwt_secret: piper-dev-jwt-secret
    token_ttl_hours: 72
    users:
      - username: admin
        password: password
  session:
    driver: sqlite
    sqlite_path: "../../data/gateway.db"
  classifier:
    mode: rule          # rule | llm（llm 模式复用下方 llm 段，失败自动回退 rule）
    # model: ""         # 默认复用 llm.model，可指定更小的分类模型
    timeout_ms: 4000

# 子 Agent 注册表（列表格式；也兼容旧的 map 格式 agents.web_crawler.listen）
# module：Python Worker 模块（默认 piper_agent.workers.<id>）。
# python_project（可选）：含 .venv 的目录名；默认从 module 推断（piper_agent.* → general_agent）。
# piper-serve 为每个 enabled Agent 仅使用其 python_project/.venv，不共用虚拟环境。
agents:
  - id: web_crawler
    display_name: "网页采集"
    description: "自然语言描述网页抓取/数据采集任务（piper-serve 内 Go Worker + 内嵌 Runtime）"
    enabled: true
  - id: general_chat
    display_name: "通用对话"
    description: "日常问答、知识咨询、闲聊等非采集类对话"
    listen: "127.0.0.1:15062"
    enabled: true
    default: true       # 意图未命中时的兜底 Agent
    module: piper_agent.workers.general_chat    # general_agent 项目（平台通用）
  - id: doc_rag
    display_name: "文档问答"
    description: "上传 PDF/Word 文档后基于文档内容问答（Web 上传文件时自动路由，跳过意图识别）"
    listen: "127.0.0.1:15063"
    enabled: true
    module: rag_agent.workers.doc_rag
  - id: paper_search
    display_name: "论文检索"
    description: "联网检索 arXiv 学术论文并由大模型汇总展示"
    listen: "127.0.0.1:15064"
    enabled: true
    module: paper_agent.workers.paper_search
  - id: word2ppt
    display_name: "文档转 PPT"
    description: "上传 Word/PDF/Excel 等文件，自动生成汇总展示用演示文稿并可下载"
    listen: "127.0.0.1:15065"
    enabled: true
    module: word2ppt_agent.workers.word2ppt
  - id: enterprise_ops
    display_name: "企业运营智囊"
    description: "Skills 架构：SQL 经营数据、文档 OCR、财务建模、竞品联网调研与综合报告"
    listen: "127.0.0.1:15066"
    enabled: true
    module: enterprise_agent.workers.enterprise_ops
  - id: nl2sql
    display_name: "半导体 NL2SQL"
    description: "自然语言查询半导体演示数仓（良率/WIP/OEE），模版化 SQL + 图表解读"
    listen: "127.0.0.1:15067"
    enabled: true
    module: nl2sql_agent.workers.nl2sql

# NL2SQL（nl2sql Agent，需先 docker compose 启动 PostgreSQL，见 nl2sql_agent/README.md）
nl2sql:
  dsn: "postgresql://piper:piper_nl2sql@127.0.0.1:5433/semi_dw"
  use_llm_extract: false
  use_llm_explain: true

# Worker 生成的 PPT 与网关下载接口共用目录（相对本 yaml 所在目录）
artifacts:
  dir: "../../data/artifacts"

# 文档转 PPT（word2ppt Agent，可选）
word2ppt:
  use_llm: true              # 用大模型规划章节/要点/主题（复用上方 llm 段）
  max_slides_total: 24       # 大纲总页数上限（页型更丰富时可略增）
  max_source_chars: 28000    # 送入模型的文档字符上限
  fallback_rule_layout: true # 大模型失败时回退规则排版
  max_slides_per_doc: 24     # 仅规则排版兜底时使用
  max_bullets_per_slide: 6
  max_chars_per_bullet: 220

# 文档 RAG（可选，未配置时使用内置默认值）
rag:
  chunk_size: 900
  chunk_overlap: 120
  top_k: 8

# 企业运营智囊（enterprise_ops Agent，可选）
enterprise_ops:
  sql_db_path: "../../data/enterprise_demo.sqlite"  # 演示销售库（首次自动建表灌数）
  max_skill_steps: 8
  max_history_messages: 20
  web_search_max_results: 5
  scrape_max_chars: 12000
  scrape_timeout_seconds: 25

# 论文检索（paper_search Agent，可选）
paper_search:
  max_results_cap: 20
  arxiv_timeout_seconds: 30
  max_history_messages: 24

llm:
  provider: openai
  model: gpt-4o
  api_key: ""
  # base_url: "https://api.deepseek.com"

harness:
  max_steps: 20
  require_validate_before_run: true
  max_runs_per_session: 10
  audit_log: "../../logs/agent_audit.jsonl"
  site_probe_max_bytes: 65536
  site_probe_timeout_seconds: 25
  auto_save_templates: true
  saved_templates_dir: "../../data/saved_templates"
